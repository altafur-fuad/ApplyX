# Supabase Configuration
# The base URL of your Supabase project
SUPABASE_URL=your_supabase_url_here

# Service Role Key for backend administration
# WARNING: This is backend-only. It must NEVER be exposed to Flutter/client code.
# It grants full database access bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
