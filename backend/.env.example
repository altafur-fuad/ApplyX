# Supabase Configuration
# The base URL of your Supabase project
SUPABASE_URL=your_supabase_url_here

# Service Role Key for backend administration
# WARNING: This is backend-only. It must NEVER be exposed to Flutter/client code.
# It grants full database access bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Generic LLM Configuration
# Choose one of: mock, openai, gemini, openai_compatible
# LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=gemini
# LLM_PROVIDER=openai_compatible

LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Fallback Configuration
LLM_FALLBACK_PROVIDER=mock
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# Generic Search Configuration
# Choose one of: mock, tavily
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_BASE_URL=

SEARCH_FALLBACK_PROVIDER=mock
SEARCH_FALLBACK_API_KEY=
SEARCH_FALLBACK_BASE_URL=

# Legacy API Keys (also supported)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
