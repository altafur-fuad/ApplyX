# ============================================================
# ApplyX environment template
# Copy to the appropriate local/staging/production environment.
# NEVER commit real secrets.
# ============================================================

# -------------------------
# Flutter / public client configuration
# -------------------------
# Safe to expose only values intended for client use.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
API_BASE_URL=https://api-staging.example.com/v1

# -------------------------
# FastAPI backend
# -------------------------
APP_ENV=development
APP_NAME=ApplyX
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Supabase server-side credentials
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_SERVER_ONLY

# JWT verification settings if backend verifies tokens directly
SUPABASE_JWT_SECRET=REPLACE_ON_SERVER_ONLY

# -------------------------
# AI / Agent provider
# -------------------------
LLM_PROVIDER=YOUR_PROVIDER
LLM_MODEL=YOUR_MODEL
LLM_API_KEY=REPLACE_ON_SERVER_ONLY

# Optional secondary model/provider
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# -------------------------
# Search / data sources
# -------------------------
SEARCH_PROVIDER=YOUR_SEARCH_PROVIDER
SEARCH_API_KEY=REPLACE_ON_SERVER_ONLY

# -------------------------
# Notifications
# -------------------------
PUSH_PROVIDER=YOUR_PUSH_PROVIDER
PUSH_SERVER_KEY=REPLACE_ON_SERVER_ONLY

# -------------------------
# Observability
# -------------------------
SENTRY_DSN=
ANALYTICS_WRITE_KEY=

# -------------------------
# Storage / file limits
# -------------------------
MAX_UPLOAD_MB=10
AGENT_RUN_TIMEOUT_MINUTES=10
MAX_TASKS_PER_RUN=25
MAX_TOOL_CALLS_PER_RUN=50
MAX_RETRIES_PER_TASK=2

# -------------------------
# Security / production settings
# -------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENABLE_DEBUG=false

# Note:
# Production secrets must be injected by the deployment platform's secret manager.
# Do not put production values into .env.example or commit them to Git.
